# Skopiuj do .env i uzupełnij własnymi wartościami. Plik .env nie trafia do repozytorium.

# Porty wystawione na komputerze hosta
APP_PORT=8080
POSTGRES_PORT=5433
MAILPIT_PORT=8025
PGADMIN_PORT=5050

# PostgreSQL (wewnątrz sieci Dockera host to nazwa usługi: db)
POSTGRES_DB=dartarena
POSTGRES_USER=dartarena
POSTGRES_PASSWORD=change_me

# pgAdmin
PGADMIN_CONTAINER_NAME=pg-admin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
